{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cortex Docs",
  "description": "Voice AI for restaurants — Cortex answers calls, takes orders, and syncs with your POS 24/7.",
  "colors": {
    "primary": "#E52E2E",
    "light": "#FF6B6B",
    "dark": "#C21818"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://cor-tex.solutions"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#FAF4EA",
      "dark": "#15110D"
    }
  },
  "fonts": {
    "family": "Cabinet Grotesk",
    "source": "/fonts/CabinetGrotesk-Variable.woff2",
    "format": "woff2"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction", "quickstart", "going-live"]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/getting-access",
              "dashboard/overview",
              "dashboard/in-store-mode",
              "dashboard/orders",
              "dashboard/calls",
              "dashboard/analytics",
              "dashboard/settings",
              "dashboard/support"
            ]
          },
          {
            "group": "Voice Core",
            "pages": [
              "voice-core/overview",
              "voice-core/voice-configuration",
              "voice-core/store-hours",
              "voice-core/faqs"
            ]
          },
          {
            "group": "Orders",
            "pages": ["orders/overview", "orders/menu", "orders/pos"]
          },
          {
            "group": "Help",
            "pages": ["faq"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.cor-tex.solutions"
        },
        {
          "anchor": "Support",
          "href": "mailto:cortextechnologyai@gmail.com"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Get a demo",
        "href": "https://cor-tex.solutions"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.cor-tex.solutions"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "mcp"]
  },
  "footer": {
    "socials": {
      "website": "https://cor-tex.solutions",
      "linkedin": "https://www.linkedin.com/in/hamoodey/"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.cor-tex.solutions"
    }
  }
}
